# Copy this file to `.env` and replace every placeholder.
# `.env` is gitignored. Never commit real secrets, and never put them in this file.
# `playwright.config.ts` loads `.env` for `npx playwright test`.

# -----------------------------------------------------------------------------
# Run tests
# Required to clone and run Playwright.
# -----------------------------------------------------------------------------

# Didaxis environment under test. Playwright uses this as baseURL.
DIDAXIS_URL=https://test.didaxis.studio

# Account the setup project signs in with. The session is saved to playwright/.auth/user.json.
DIDAXIS_EMAIL=you@example.com

# Password for DIDAXIS_EMAIL.
DIDAXIS_PASSWORD=replace-me

# Bearer token for API cleanup of programs a test creates.
DIDAXIS_API_TOKEN=replace-me

# Optional. Second account for permission probes.
DIDAXIS_ALT_EMAIL=other@example.com

# Optional. Password for DIDAXIS_ALT_EMAIL.
DIDAXIS_ALT_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# Agent / CI setup
# Not needed for `npx playwright test` alone.
# The headless agent in .github/workflows/test-generation.yml reads these from
# GitHub Actions secrets. Locally, put MCP tokens in Cursor settings.
# -----------------------------------------------------------------------------

# Cursor API key for the headless `agent -p` run.
CURSOR_API_KEY=replace-me

# Atlassian API token for the Jira and Confluence MCP.
ATLASSIAN_API_TOKEN=replace-me

# Atlassian site URL for that token.
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email that owns ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com

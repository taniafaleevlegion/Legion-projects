{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/generation-gate.mjs",
        "matcher": "Write",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/block-weakened-assertion.mjs",
        "matcher": "Write",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/block-wont.mjs",
        "matcher": "Write",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/eval-report.mjs",
        "timeout": 180
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/eval-report.mjs",
        "timeout": 180
      }
    ]
  }
}

# Copy this file to `.env` and replace placeholders with real values.
# Never commit `.env` — it may contain secrets.

# Application under test (used by Playwright baseURL when enabled)
BASE_URL=https://your-app.example.com

# Demo / public targets (no login required)
TODO_MVC_URL=https://demo.playwright.dev/todomvc/#/

# Admin credentials (program management flows)
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-admin-password

# Non-admin credentials (RBAC / negative auth tests)
NON_ADMIN_EMAIL=your-user@example.com
NON_ADMIN_PASSWORD=your-user-password

# Optional: API access for setup, teardown, or contract checks
API_BASE_URL=https://api.your-app.example.com
API_TOKEN=your-api-bearer-token

# Optional: third-party integrations (Jira, etc.)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-jira@example.com
JIRA_API_TOKEN=your-jira-api-token
